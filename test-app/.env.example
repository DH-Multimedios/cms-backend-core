# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=backend_core_dev
DB_SYNCHRONIZE=true
DB_LOGGING=true

# JWT
JWT_SECRET=test-secret-change-in-production
JWT_EXPIRATION=1d
JWT_REFRESH_SECRET=test-refresh-secret-change-in-production
JWT_REFRESH_EXPIRATION=7d

# System User
SYSTEM_USER_EMAIL=dev@example.com
SYSTEM_USER_PASSWORD=dev-password

# SuperAdmin
SUPERADMIN_EMAIL=admin@test.com
SUPERADMIN_PASSWORD=admin-password

# Admin
ADMIN_EMAIL=support@test.com
ADMIN_PASSWORD=support-password

# SMTP
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=test@example.com
SMTP_PASS=test-password
SMTP_FROM=noreply@test.com
SMTP_FROM_NAME=Backend Core Test

# CORS
CORS_ORIGINS=http://localhost:3001,http://localhost:4200
