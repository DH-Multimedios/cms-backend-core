meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "login": "{{SUSER}}",
    "password": "{{SPASS}}"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("token", res.body.data.accessToken);
    bru.setVar("refreshToken", res.body.data.refreshToken);
  }
}
