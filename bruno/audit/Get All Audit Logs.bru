meta {
  name: Get All Audit Logs
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/audit
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

params:query {
  ~userId: USER-UUID-AQUI
  ~action: create
  ~entity: User
  ~from: 2026-01-01
  ~to: 2026-12-31
  ~sortBy: createdAt
  ~sortOrder: DESC
  ~page: 1
  ~limit: 20
}
