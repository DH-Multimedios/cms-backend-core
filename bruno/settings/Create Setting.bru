meta {
  name: Create Setting
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/settings
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "categoryId": 1,
    "key": "app.name",
    "label": "Nombre de la aplicación",
    "value": "Mi App",
    "description": "Nombre que aparece en el dashboard",
    "type": "string",
    "inputType": "text",
    "order": 1
  }
}

docs {
  ## Ejemplos por inputType

  ### text / url / email / color / date / password
  { "type": "string", "inputType": "text", "value": "algo", "meta": null }

  ### textarea
  { "type": "string", "inputType": "textarea", "value": "texto largo", "meta": { "rows": 5 } }

  ### number
  { "type": "number", "inputType": "number", "value": "10", "meta": { "min": 0, "max": 100 } }

  ### toggle
  { "type": "boolean", "inputType": "toggle", "value": "true", "meta": null }

  ### select / radio  (valor único)
  { "type": "string", "inputType": "select", "value": "smtp", "meta": { "options": [{"value":"smtp","label":"SMTP"},{"value":"resend","label":"Resend"}] } }

  ### checkbox  (valor múltiple → JSON array)
  { "type": "json", "inputType": "checkbox", "value": "[\"opcion1\",\"opcion2\"]", "meta": { "options": [{"value":"opcion1","label":"Opción 1"},{"value":"opcion2","label":"Opción 2"}] } }
}
