# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api
BASE_URL=http://localhost:3000

# Storage
UPLOADS_PATH=uploads

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=backend_core_dev
DB_SYNCHRONIZE=true
DB_LOGGING=true

# JWT
JWT_SECRET=change-this-secret-in-production
JWT_EXPIRATION=1d
JWT_REFRESH_SECRET=change-this-refresh-secret-in-production
JWT_REFRESH_EXPIRATION=7d

# System User (DEVELOPER/OWNER - ÚNICO EN TODO EL SISTEMA)
SYSTEM_USER_EMAIL=tu-email@personal.com
SYSTEM_USER_PASSWORD=password-ultra-segura-cambiar-en-produccion

# SuperAdmin (Cliente)
SUPERADMIN_EMAIL=admin@cliente.com
SUPERADMIN_PASSWORD=password-del-cliente

# Admin (Cliente - opcional)
ADMIN_EMAIL=support@cliente.com
ADMIN_PASSWORD=password-del-cliente

# File Upload
UPLOAD_MAX_FILE_SIZE=10485760
UPLOAD_ALLOWED_FILE_TYPES=.pdf,.doc,.docx,.xls,.xlsx,.txt

# Media Upload
MEDIA_MAX_FILE_SIZE=5242880
MEDIA_ALLOWED_TYPES=.jpg,.jpeg,.png,.gif,.webp
MEDIA_STORAGE_PATH=./uploads/media

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=smtp-password
SMTP_FROM=noreply@example.com
SMTP_FROM_NAME=Backend Core

# Cors
CORS_ORIGINS=http://localhost:3001,http://localhost:4200
